diff --git a/src/reader/tests.rs b/src/reader/tests.rs
index 30d955d..6c9c199 100644
--- a/src/reader/tests.rs
+++ b/src/reader/tests.rs
@@ -1481,3 +1481,71 @@ fn readers_recover_their_original_sources() {
