{
    "file_scan_exclusions": [
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/target",
        "**/.git"
    ],
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "linkedProjects": [
                    "Cargo.toml",
                    "palantir/Cargo.toml",
                    "fits-well/Cargo.toml"
                ],
                "cargo": {
                    "features": "all",
                    "allTargets": true,
                    "targetDir": true
                },
                "check": {
                    "allTargets": true,
                    "features": "all"
                },
                "runnables": {
                    "extraArgs": [""],
                    "extraTestBinaryArgs": ["--nocapture"]
                }
            }
        }
    }
}
