[
  {
    "label": "run darkroom",
    // `env` rather than a `VAR=1 cargo` command prefix: that prefix is POSIX
    // shell syntax, and Zed spawns tasks through PowerShell on Windows, which
    // reads it as a command name and fails.
    "command": "cargo",
    "args": ["run", "-p", "darkroom-app"],
    "env": { "RUST_BACKTRACE": "1" },
  },
  {
    "label": "run darkroom release-dev",
    "command": "cargo",
    "args": ["run", "--profile", "release-dev", "-p", "darkroom-app"],
    "env": { "RUST_BACKTRACE": "1" },
  },
  {
    "label": "run darkroom with tracy",
    "command": "cargo",
    "args": [
      "run",
      "--profile",
      "bench",
      "-p",
      "darkroom-app",
      "--features",
      "darkroom/profile-with-tracy",
    ],
  },
  {
    "label": "run palantir showcase",
    "command": "cargo",
    "args": [
      "run",
      "--profile",
      "release-dev",
      "--manifest-path",
      "palantir/Cargo.toml",
      "--example",
      "showcase",
    ],
    "env": { "RUST_BACKTRACE": "1" },
  },
  {
    "label": "run palantir showcase with tracy",
    "command": "cargo",
    "args": [
      "run",
      "--profile",
      "bench",
      "--manifest-path",
      "palantir/Cargo.toml",
      "--example",
      "showcase",
      "--features",
      "profile-with-tracy",
    ],
  },
]
