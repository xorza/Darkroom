[
  {
    "label": "run darkroom",
    "command": "cargo",
    "args": ["run", "-p", "darkroom"],
  },
  {
    "label": "run darkroom release",
    "command": "cargo",
    "args": ["run", "--release", "-p", "darkroom"],
  },
  {
    "label": "run darkroom release-max with tracy",
    "command": "cargo",
    "args": [
      "run",
      "--profile",
      "release-max",
      "-p",
      "darkroom",
      "--features",
      "profile-with-tracy",
    ],
  },
  {
    "label": "run palantir showcase",
    "command": "RUST_BACKTRACE=1 cargo",
    "args": [
      "run",
      "--release",
      "--manifest-path",
      "palantir/Cargo.toml",
      "--bin",
      "showcase",
      "--features",
      "showcase",
    ],
  },
  {
    "label": "run palantir showcase with tracy",
    "command": "RUST_BACKTRACE=1 cargo",
    "args": [
      "run",
      "--profile",
      "release-max",
      "--manifest-path",
      "palantir/Cargo.toml",
      "--bin",
      "showcase",
      "--features",
      "showcase,profile-with-tracy",
    ],
  },
]
