[
  {
    "label": "run darkroom",
    // `env` rather than a `VAR=1 cargo` command prefix: that prefix is POSIX
    // shell syntax, and Zed spawns tasks through PowerShell on Windows, which
    // reads it as a command name and fails.
    "command": "cargo",
    "args": ["run", "-p", "darkroom"],
    "env": { "RUST_BACKTRACE": "1" },
  },
  {
    "label": "run darkroom release",
    "command": "cargo",
    "args": ["run", "--release", "-p", "darkroom"],
    "env": { "RUST_BACKTRACE": "1" },
  },
  {
    "label": "run darkroom release-max with tracy",
    "command": "cargo",
    "args": [
      "run",
      "--profile",
      "release-max",
      "-p",
      "darkroom",
      "--features",
      "profile-with-tracy",
    ],
  },
  {
    "label": "run palantir showcase",
    "command": "cargo",
    "args": [
      "run",
      "--release",
      "--manifest-path",
      "palantir/Cargo.toml",
      "--example",
      "showcase",
    ],
    "env": { "RUST_BACKTRACE": "1" },
  },
  {
    "label": "run palantir showcase with tracy",
    "command": "cargo",
    "args": [
      "run",
      "--profile",
      "release-max",
      "--manifest-path",
      "palantir/Cargo.toml",
      "--example",
      "showcase",
      "--features",
      "profile-with-tracy",
    ],
  },
]
