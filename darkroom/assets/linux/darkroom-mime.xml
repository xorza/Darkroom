<?xml version="1.0" encoding="UTF-8"?>
<!--
  The shared-mime-info package for darkroom projects. Installed by
  `install.sh` as <data dir>/mime/packages/darkroom.xml.

  A project is a zip. `sub-class-of` keeps archive handlers working and makes
  the glob outrank the container's own `application/zip` sniff, so a named
  file needs nothing else. The magic — `document.json` at offset 30, past the
  signature and local file header — covers only the extensionless case, and
  flatpak strips magic rules on export, leaving a flatpak install glob-only.

  No `<icon>` element needed; the default lookup is the type with `/` as `-`.
  `flatpak.sh` splices one in, anchored on the `sub-class-of` line below.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-darkroom">
    <comment>Darkroom project</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.darkroom"/>
    <magic priority="60">
      <match type="string" value="PK\003\004" offset="0">
        <match type="string" value="document.json" offset="30"/>
      </match>
    </magic>
  </mime-type>
</mime-info>
