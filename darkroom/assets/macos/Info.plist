<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle property list for Darkroom.app. Launch Services reads this out of
  a bundle and nowhere else, so a bare binary cannot be registered at all;
  install.sh assembles the bundle around it and registers the result.

  KNOWN GAP — double-clicking a document launches Darkroom empty. macOS sends
  the path as an Apple Event (`application:openURLs:` on the
  NSApplicationDelegate), never in argv. winit 0.30.13 both exposes no API for
  it and holds the delegate slot itself, panicking if replaced
  (rust-windowing/winit#4458) — so closing the gap means extending winit's own
  delegate and handing the path to `App` through `HostHandle::run_on_main`,
  which already buffers calls made before the app exists.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Darkroom</string>
	<key>CFBundleDisplayName</key>
	<string>Darkroom</string>
	<key>CFBundleIdentifier</key>
	<string>com.cssodessa.darkroom</string>
	<key>CFBundleExecutable</key>
	<string>darkroom</string>
	<key>CFBundleIconFile</key>
	<string>darkroom.icns</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Version keys are absent by design: install.sh stamps them from
	     `darkroom --version`, so no copy lives here to drift. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- What the type *is*. Exported because darkroom owns the format; the zip
	     conformance is what the file actually is, so archive tools keep
	     working while this more specific type wins for us. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.cssodessa.darkroom.project</string>
			<key>UTTypeDescription</key>
			<string>Darkroom Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.pkware.zip-archive</string>
			</array>
			<key>UTTypeIconFile</key>
			<string>darkroom.icns</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>darkroom</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- That we open it. `Owner` rank is what beats the archive tools our UTI
	     conforms to. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Darkroom Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.cssodessa.darkroom.project</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>darkroom.icns</string>
		</dict>
	</array>
</dict>
</plist>
