<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Darkroom</string>
	<key>CFBundleDisplayName</key>
	<string>Darkroom</string>
	<key>CFBundleIdentifier</key>
	<string>com.cssodessa.darkroom</string>
	<key>CFBundleExecutable</key>
	<string>darkroom</string>
	<key>CFBundleIconFile</key>
	<string>darkroom.icns</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Version keys are absent by design: install.sh and bundle.sh stamp them
	     from what the binary reports as its version, so no copy lives here to
	     drift. (Not the flag itself: XML refuses a double hyphen in a comment.) -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- What the types *are*. Exported because darkroom owns the formats; the
	     conformance is what each file actually is, plain text or a zip, so text
	     editors and archive tools keep working while the more specific type wins
	     for us. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.cssodessa.darkroom.project</string>
			<key>UTTypeDescription</key>
			<string>Darkroom Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>UTTypeIconFile</key>
			<string>darkroom.icns</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>darkroom</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.cssodessa.darkroom.compressed-project</string>
			<key>UTTypeDescription</key>
			<string>Compressed Darkroom Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.pkware.zip-archive</string>
			</array>
			<key>UTTypeIconFile</key>
			<string>darkroom.icns</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>darkroomz</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- That we open it. `Owner` rank is what beats the archive tools our UTI
	     conforms to. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Darkroom Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.cssodessa.darkroom.project</string>
				<string>com.cssodessa.darkroom.compressed-project</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>darkroom.icns</string>
		</dict>
	</array>
</dict>
</plist>
